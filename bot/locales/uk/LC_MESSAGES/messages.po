# Messages

msgid "Choose the language you prefer:"
msgstr "Оберіть мову, якою буде спілкуватися бот:"

msgid "Your language is now {language}"
msgstr "Тепер ваша мова — {language}"

msgid "Something went wrong. Try again later."
msgstr "Щось пішло не так. Спробуйте пізніше."

msgid "Hello, {first_name} @{username}!"
msgstr "Привіт, {first_name} @{username}!"

msgid "<b>📅 Your tasks</b>\n"
msgstr "<b>📅 Ваші завдання</b>\n"

msgid "📋 Collecting your tasks... Please wait..."
msgstr "📋 Збираємо ваші завдання... Будь ласка, зачекайте..."

msgid "📭 You don't have any tasks yet."
msgstr "📭 У вас поки що немає завдань."

msgid "Awaiting your tasks:"
msgstr "Надішліть ваші завдання:"

msgid "Command was cancelled."
msgstr "Команду скасовано."

msgid "What would you like to do next?"
msgstr "Що ви хочете зробити далі?"

msgid "Are these tasks correct?\n\n{current_tasks}"
msgstr "Ці завдання правильні?\n\n{current_tasks}"

msgid "Okay, send the tasks again:"
msgstr "Гаразд, надішліть завдання ще раз:"

msgid "Please wait... Your tasks are being processed..."
msgstr "Будь ласка, зачекайте... Ваші завдання обробляються..."

msgid "Your tasks successfully saved!"
msgstr "Ваші завдання успішно збережено!"

msgid "Sorry, I don't understand this command."
msgstr "Вибачте, я не розумію цю команду."

msgid "Bot does not support this type of file."
msgstr "Бот не підтримує цей тип файлу."

msgid "In the future, we will add support for processing voice recordings, text files, and photos."
msgstr "У майбутньому ми додамо підтримку обробки голосових повідомлень, текстових файлів і фото."

